# Cyber Task Hub — örnek ortam değişkenleri. Kopyala: cp .env.example .env
# Yer tutucuları kendi değerlerinizle değiştirin; .env asla commit edilmez. Gerçek ortamda secret yöneticisi kullanın.

# PostgreSQL (owner: migration'lar, app: uygulama — audit_logs üzerinde UPDATE/DELETE yetkisi yok)
POSTGRES_DB=cyber_task_hub
POSTGRES_USER=cth_owner
POSTGRES_PASSWORD=<owner-db-parolası>
CTH_APP_DB_PASSWORD=<app-db-parolası>
DATABASE_URL=postgresql+psycopg://cth_app:<app-db-parolası>@localhost:5433/cyber_task_hub
MIGRATION_DATABASE_URL=postgresql+psycopg://cth_owner:<owner-db-parolası>@localhost:5433/cyber_task_hub

# API
CTH_ENV=development
CTH_COOKIE_SECURE=false
CTH_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
CTH_SESSION_HOURS=8
CTH_SESSION_IDLE_MINUTES=30
CTH_PUBLIC_BASE_URL=http://localhost:8080

# E-posta (Mailpit yakalar: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=cyber-task-hub@demo.local

# Seed — demo hesaplarının ortak parolası (sadece demo)
CTH_SEED_PASSWORD=<demo-hesap-parolası>

# MCP sunucusu (stdio modunda kullanıcının kişisel API token'ı)
CTH_API_BASE_URL=http://localhost:8000/api/v1
CTH_API_TOKEN=
